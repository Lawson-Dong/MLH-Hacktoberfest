# Optional; the public demo and deterministic scanner work without credentials.
# Set secrets directly in your local shell or Vercel environment settings.
GITHUB_TOKEN=

# Recommended for no-cost Gemma demo: OpenRouter's free Gemma 3 27B model.
# Create a token at https://openrouter.ai/settings/keys and save it as a Vercel Secret.
# Free requests are rate-limited. When set, this takes precedence over MODEL_*.
OPENROUTER_API_KEY=

# Alternative OpenAI-compatible endpoint (e.g. Hugging Face routed inference).
# Hugging Face may return HTTP 402 when credits or billing are unavailable.
# Optional OpenAI-compatible endpoint for an open-weight model (e.g. your Gemma deployment).
# Use the exact model ID exposed by your provider. No hosted model is enabled by default.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
