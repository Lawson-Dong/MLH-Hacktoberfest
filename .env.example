# The scanner, review, mocks, and demo work without any model API credentials.
# Keep real credentials only in local environment or Vercel's backend Secrets.
GITHUB_TOKEN=

# Recommended: Groq's free-tier Qwen 3.8 27B, https://console.groq.com/keys
# MODEL_PROVIDER=groq prevents fallback to legacy provider credentials until Groq is ready.
MODEL_PROVIDER=groq
GROQ_API_KEY=

# Optional legacy provider (used only if MODEL_PROVIDER is not groq and GROQ_API_KEY is absent).
OPENROUTER_API_KEY=

# Optional generic OpenAI-compatible model endpoint. May have separate charges.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
