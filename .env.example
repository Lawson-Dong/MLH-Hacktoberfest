# The scanner, review, mocks, and demo work without any model API credentials.
# Keep real credentials only in local environment or Vercel's backend Secrets.
GITHUB_TOKEN=

# DeepSeek V4.1 (deepseek-flash) via the official OpenAI-compatible API.
# This is the default provider in this repository.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# xAI / Grok. The existing deployed Grok_API_Key Secret is also supported.
# Grok credentials go only to https://api.x.ai/v1/responses.
# MODEL_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Optional Groq / Qwen provider: explicitly set MODEL_PROVIDER=groq.
# This is a different service and requires its own Groq credential.
GROQ_API_KEY=

# Optional legacy provider: MODEL_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Optional generic OpenAI-compatible endpoint: MODEL_PROVIDER=generic.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
